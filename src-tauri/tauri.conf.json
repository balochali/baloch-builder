{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baloch Builder",
  "version": "0.1.0",
  "identifier": "com.baloch-pc.baloch-builder",
  "build": {
    "beforeDevCommand": "node --env-file-if-exists=.env.local scripts/start-desktop-dev.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "title": "Baloch Builder",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Baloch Builder",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
