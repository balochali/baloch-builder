# Use distinct random URL-safe passwords; percent-encode passwords in URLs.
POSTGRES_PASSWORD=replace-admin-password
OWNER_PASSWORD=replace-owner-password
APP_PASSWORD=replace-app-password
ADMIN_DATABASE_URL=postgres://postgres:replace-admin-password@127.0.0.1:5432/baloch
OWNER_DATABASE_URL=postgres://baloch_owner:replace-owner-password@127.0.0.1:5432/baloch
DATABASE_URL=postgres://baloch_app:replace-app-password@127.0.0.1:5432/baloch
TOTP_ENCRYPTION_KEY=replace-with-64-random-hex-characters
ATTACHMENT_DIR=./var/attachments
